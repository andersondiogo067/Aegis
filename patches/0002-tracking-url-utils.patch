+// Copyright 2026 The Aegis Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/privacy/tracking_url_utils.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+
+namespace aegis {
+namespace {
+
+constexpr std::array<std::string_view, 9> kTrackingParameters = {
+    "fbclid", "gclid", "dclid", "msclkid", "mc_cid",
+    "mc_eid", "igshid", "vero_conv", "vero_id"};
+
+int HexValue(char c) {
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  return -1;
+}
+
+std::string DecodeKeyForComparison(std::string_view raw_key) {
+  std::string decoded;
+  decoded.reserve(raw_key.size());
+  for (size_t i = 0; i < raw_key.size(); ++i) {
+    const char c = raw_key[i];
+    if (c == '+') {
+      decoded.push_back(' ');
+      continue;
+    }
+    if (c == '%' && i + 2 < raw_key.size()) {
+      const int high = HexValue(raw_key[i + 1]);
+      const int low = HexValue(raw_key[i + 2]);
+      if (high >= 0 && low >= 0) {
+        decoded.push_back(static_cast<char>((high << 4) | low));
+        i += 2;
+        continue;
+      }
+    }
+    decoded.push_back(c);
+  }
+  return base::ToLowerASCII(decoded);
+}
+
+bool IsTrackingKey(std::string_view raw_part) {
+  const size_t equals = raw_part.find('=');
+  const std::string key = DecodeKeyForComparison(raw_part.substr(0, equals));
+  if (base::StartsWith(key, "utm_", base::CompareCase::SENSITIVE))
+    return true;
+  for (std::string_view known : kTrackingParameters) {
+    if (key == known)
+      return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+GURL StripTrackingParameters(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_query())
+    return url;
+
+  const std::string_view query = url.query();
+  std::string kept;
+  kept.reserve(query.size());
+  bool changed = false;
+  bool first_kept = true;
+
+  size_t start = 0;
+  while (start <= query.size()) {
+    size_t end = query.find('&', start);
+    if (end == std::string_view::npos)
+      end = query.size();
+    const std::string_view part = query.substr(start, end - start);
+    if (IsTrackingKey(part)) {
+      changed = true;
+    } else {
+      if (!first_kept)
+        kept.push_back('&');
+      kept.append(part);
+      first_kept = false;
+    }
+    if (end == query.size())
+      break;
+    start = end + 1;
+  }
+
+  if (!changed)
+    return url;
+
+  GURL::Replacements replacements;
+  if (kept.empty())
+    replacements.ClearQuery();
+  else
+    replacements.SetQueryStr(kept);
+  return url.ReplaceComponents(replacements);
+}
+
+}  // namespace aegis
