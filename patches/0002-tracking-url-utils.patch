+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_BROWSER_PRIVACY_TRACKING_URL_UTILS_H_
+#define CHROME_BROWSER_PRIVACY_TRACKING_URL_UTILS_H_
+
+#include "url/gurl.h"
+
+namespace aegis {
+
+// Removes explicit click identifiers and the utm_ namespace from HTTP(S)
+// queries. Unknown query parts retain their raw order and spelling.
+GURL StripTrackingParameters(const GURL& url);
+
+}  // namespace aegis
+
+#endif  // CHROME_BROWSER_PRIVACY_TRACKING_URL_UTILS_H_
diff --git a/chrome/browser/privacy/tracking_url_utils_unittest.cc b/chrome/browser/privacy/tracking_url_utils_unittest.cc
new file mode 100644
index 0000000..d155b55
--- /dev/null
+++ b/chrome/browser/privacy/tracking_url_utils_unittest.cc
@@ -0,0 +1,47 @@
+// Copyright 2026 The Aegis Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/privacy/tracking_url_utils.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis {
+namespace {
+
+TEST(TrackingUrlUtilsTest, RemovesKnownKeysAndPreservesUnknownQuery) {
+  EXPECT_EQ(
+      "https://shop.example/item?sku=42&color=blue#details",
+      StripTrackingParameters(GURL(
+          "https://shop.example/item?sku=42&utm_source=x&color=blue&fbclid=y#details"))
+          .spec());
+}
+
+TEST(TrackingUrlUtilsTest, MatchesCaseAndPercentEncodedKeys) {
+  EXPECT_EQ("https://example.test/?keep=1",
+            StripTrackingParameters(GURL(
+                "https://example.test/?UTM_Campaign=x&%67clid=y&keep=1"))
+                .spec());
+}
+
+TEST(TrackingUrlUtilsTest, PreservesDuplicatesEmptyPartsAndRawValues) {
+  EXPECT_EQ("https://example.test/?a=1&&a=%2F&",
+            StripTrackingParameters(GURL(
+                "https://example.test/?a=1&&utm_x=z&a=%2F&"))
+                .spec());
+}
+
+TEST(TrackingUrlUtilsTest, LeavesUnknownAndNonHttpUrlsUnchanged) {
+  const GURL unknown("https://example.test/?custom_id=7");
+  const GURL mailto("mailto:a@example.test?utm_source=x");
+  EXPECT_EQ(unknown, StripTrackingParameters(unknown));
+  EXPECT_EQ(mailto, StripTrackingParameters(mailto));
+}
+
+TEST(TrackingUrlUtilsTest, IsIdempotent) {
+  const GURL source("https://example.test/?utm_source=x&a=1");
+  const GURL once = StripTrackingParameters(source);
+  EXPECT_EQ(once, StripTrackingParameters(once));
+}
+
+}  // namespace
+}  // namespace aegis
